# STAGING-инстанс (ветка test → авто-деплой на staging). Параллельно проду: своя БД/медиа/домен.
# Секреты в GitLab CI/CD variables: SECRET_KEY, DB_PASSWORD, EMAIL_HOST_PASSWORD, TELEGRAM_BOT_TOKEN.
# REGISTRY_IMAGE и IMAGE_TAG проставляет CI ($CI_REGISTRY_IMAGE / commit SHA).
COMPOSE_PROJECT_NAME=ssu138site-ssu138-staging
DOMAIN=ssu138.test.kotpilota.ru
ROUTER_RULE=Host(`ssu138.test.kotpilota.ru`)

# ── Django ───────────────────────────────────────────────────────────
ALLOWED_HOSTS=ssu138.test.kotpilota.ru,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://ssu138.test.kotpilota.ru

# ── Database ─────────────────────────────────────────────────────────
DB_NAME=ssu138
DB_USER=ssu138

# ── Email (на staging почту глушим, чтобы не слать боевые письма) ─────
EMAIL_HOST=host.docker.internal
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@ssu-138.ru
LEAD_RECIPIENT_EMAIL=info@ssu-138.ru

# ── Telegram (токен — в CI/CD variables) ─────────────────────────────
TELEGRAM_ENABLED=False
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
TELEGRAM_PROXY_URL=

# ── Сайт ─────────────────────────────────────────────────────────────
SITE_PHONE=+7 (916) 992-22-24
SITE_EMAIL=info@ssu-138.ru
SITE_ADDRESS=г. Москва
SITE_INN=9111027572
SITE_OGRN=1219100000932
SITE_LEGAL_NAME=ООО "ССУ 138"
SITE_ADDRESS_LEGAL=299053, г. Севастополь, ул. Отрадная, д. 15/1
SITE_OG_IMAGE=https://ssu138.test.kotpilota.ru/static/img/og-image.jpg
